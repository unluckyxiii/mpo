# Passcode for Gated Access (Configure in Vercel / GCC environment variables)
PORTAL_ACCESS_PASSCODE=your_secret_passcode_here

# Secret key for HMAC cookie signing
SESSION_SECRET=your_32_char_random_session_secret_here

# Database URL (Defaults to data/mpo.sqlite or Postgres connection string)
DATABASE_URL=data/mpo.sqlite
